[Unit]
Description=Gunicorn daemon for Vandmark Django Project
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/vandmark-site
ExecStart=/var/www/vandmark-site/.venv/bin/gunicorn \
          --workers 3 \
          --bind 127.0.0.1:8000 \
          --access-logfile /var/log/vandmark/gunicorn.access.log \
          --error-logfile /var/log/vandmark/gunicorn.error.log \
          vandmark_project.wsgi:application

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
